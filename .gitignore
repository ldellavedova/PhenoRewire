# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Environments
.venv/
venv/
env/
.env
*.conda/

# IDE and personal settings
.claude/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / lint / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp

# Metabolomics raw / large data formats — never commit
*.mzML
*.mzXML
*.raw
*.mgf
*.wiff
*.d/

# PhenoRewire outputs — never commit analysis results
results/

# 2d_network outputs and real inputs — never commit
2d_network/output/
2d_network/test_output/
2d_network/input/PhenoRewire_input/*.graphml
2d_network/input/SpecReBoot_input/*.graphml
2d_network/input/SpecReBoot_input/*.csv
2d_network/input/SpecReBoot_input/*.mgf

# User data — never commit real study data
data/*.csv
data/*.tsv
!data/feature_table.csv
!data/metadata.csv

# Demo molecular network must stay tracked
!data/example_molecular_network.graphml

# Development benchmark and simulation outputs — generated, not source
dev/benchmarks/**/*_results.csv
dev/benchmarks/profiling/*_results.csv
dev/simulate/*.csv
dev/simulate/*.png

# Fixture data files — duplicates of data/; generated by generate_example_data.py
dev/benchmarks/fixtures/feature_table.csv
dev/benchmarks/fixtures/metadata.csv
